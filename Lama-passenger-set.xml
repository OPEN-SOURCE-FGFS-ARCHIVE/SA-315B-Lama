  <menubar>
   <default>
    <menu n="100">
     <label>SA-315B-Lama</label>
     <item>
      <label>Select MP-pilot</label>
      <binding>
       <command>nasal</command>
       <script>
        dual_control_tools.
          copilot_dialog.show(aircraft_dual_control.pilot_type);
       </script>
      </binding>
     </item>
    </menu>
   </default>
  </menubar>

 </sim>
 
 <environment>
    
	<precipitation-control>
            <clip-distance type="double">1.75</clip-distance>
        </precipitation-control>
  </environment>
  
  <instrumentation>
		<gsdi>
			<serviceable type="bool">true</serviceable>
