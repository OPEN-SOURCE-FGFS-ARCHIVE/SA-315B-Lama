		<instrumentation>
			<path>Aircraft/SA-315B-Lama/Models/Interior/Panel/Instruments/instrumentation.xml</path>
		</instrumentation>

  <!-- 3d model -->
  <model>
   <path>Aircraft/SA-315B-Lama/Models/Lama-Passenger.xml</path>
  </model>
  
  <rendering>
    <refl_correction type="string">-0.2</refl_correction>
	 <fresnel-factor type="string">0.7</fresnel-factor>
    </rendering>

  <!-- Views -->
  <!--view-->
		<view n="0">
			<name>Cockpit</name>
			<!-- type>lookfrom</type -->
                  <internal archive="y">true</internal> 
			<!-- internal type="bool">true</internal -->
			<config>
                    <x-offset-m type="double">-0.445</x-offset-m><!--left-->
		        <y-offset-m type="double">0.719</y-offset-m><!--up-->
			  <z-offset-m type="double">-1.54</z-offset-m><!--back-->
			  <pitch-offset-deg>-10</pitch-offset-deg>
			  <default-field-of-view-deg type="double">70.0</default-field-of-view-deg>
              	<limits>
		      <enabled type="bool">true</enabled>
		      </limits>
			</config>
		</view>
		
		
		<view n="100">
			<name>Passenger</name>
			<type>lookfrom</type>
			<internal type="bool">true</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<ground-level-nearplane-m type="double">2f</ground-level-nearplane-m>
				 <x-offset-m type="double">0.445</x-offset-m><!--left-->
		        <y-offset-m type="double">0.719</y-offset-m><!--up-->
			  <z-offset-m type="double">-0.9</z-offset-m><!--back-->
				<pitch-offset-deg>-10</pitch-offset-deg>
				<default-field-of-view-deg type="double">95</default-field-of-view-deg>
			</config>
		</view>
		
		<view n="101">
			<name>Pilot cam</name>
			<type>lookfrom</type>
			<internal type="bool">true</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<ground-level-nearplane-m type="double">2f</ground-level-nearplane-m>
				 <x-offset-m type="double">0</x-offset-m><!--left-->
		        <y-offset-m type="double">0.8</y-offset-m><!--up-->
			  <z-offset-m type="double">-2</z-offset-m><!--back-->
				<pitch-offset-deg>-15</pitch-offset-deg>
				<heading-offset-deg>195</heading-offset-deg>
				<default-field-of-view-deg type="double">95</default-field-of-view-deg>
			</config>
		</view>
		
		<view n="102">
			<name>Winch cam</name>
			<type>lookfrom</type>
			<internal type="bool">true</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<ground-level-nearplane-m type="double">2f</ground-level-nearplane-m>
				 <x-offset-m type="double">-1.2</x-offset-m><!--left-->
		        <y-offset-m type="double">0.819</y-offset-m><!--up-->
			  <z-offset-m type="double">-0.9</z-offset-m><!--back-->
				<pitch-offset-deg>-80</pitch-offset-deg>
				<heading-offset-deg>350</heading-offset-deg>
				<default-field-of-view-deg type="double">95</default-field-of-view-deg>
			</config>
		</view>
		
		<view n="103">
			<name>Hook cam</name>
			<type>lookfrom</type>
			<internal type="bool">true</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<ground-level-nearplane-m type="double">2f</ground-level-nearplane-m>
				 <x-offset-m type="double">0</x-offset-m><!--left-->
		        <y-offset-m type="double">-0.819</y-offset-m><!--up-->
			  <z-offset-m type="double">0.9</z-offset-m><!--back-->
				<pitch-offset-deg>-95</pitch-offset-deg>
				<heading-offset-deg>0</heading-offset-deg>
				<default-field-of-view-deg type="double">95</default-field-of-view-deg>
			</config>
		</view>

		<view n="1">
			<config>
				<target-z-offset-m archive="y" type="double">-1</target-z-offset-m>
			</config>
		</view>

		<view n="2">
			<config>
				<target-z-offset-m archive="y" type="double">-1</target-z-offset-m>
			</config>
		</view>

