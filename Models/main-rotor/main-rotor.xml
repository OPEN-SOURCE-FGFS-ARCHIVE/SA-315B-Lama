		<type>rotate</type>
		<object-name>blurred1</object-name>
		<object-name>blurred2</object-name>
		<object-name>blurred3</object-name>
		<property>rotors/main/blade[0]/position-deg</property>
		<factor>1</factor>
             <axis>
			<x>0</x>
			<y>0</y>
			<z>-1</z>
		</axis>
	<center>
			<x-m>0.0</x-m>
			<y-m>0.0</y-m>
			<z-m>0.0</z-m>
		</center>
	</animation>-->

	<animation>
		<type>noshadow</type>
		<object-name>blurred1</object-name>
		<object-name>blurred2</object-name>
		<object-name>blurred3</object-name>
	</animation>

</PropertyList>

