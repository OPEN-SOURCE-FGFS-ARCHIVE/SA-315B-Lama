	<type>material</type>
	<object-name>bladeA</object-name>
          	<object-name>bladeB</object-name>
          	<object-name>bladeC</object-name>
		<global type="bool">true</global>
		<transparency>
			<alpha-prop>rotors/main/rpm</alpha-prop>
			<factor>-0.0045</factor>
			<offset>1</offset>
