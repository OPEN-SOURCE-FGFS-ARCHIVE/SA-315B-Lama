<animation>
		<type>select</type>
		<object-name>bladeA</object-name>
          	<object-name>bladeB</object-name>
          	<object-name>bladeC</object-name>
		<condition>
			<less-than>
				<property>rotors/main/rpm</property>
				<value>225</value>
			</less-than>
		</condition>
	</animation>
	
      <animation>
       <type>select</type>
		<object-name>blurred1</object-name>
		<object-name>blurred2</object-name>
		<object-name>blurred3</object-name>
          	<condition>
			<greater-than>
				<property>rotors/main/rpm</property>
				<value>200</value>
			</greater-than>
		</condition>
	</animation>

   	<animation>
		<type>material</type>
		<object-name>blurred1</object-name>
		<object-name>blurred2</object-name>
		<object-name>blurred3</object-name>
		<transparency>
			<alpha-prop>rotors/main/rpm</alpha-prop>
			<factor>0.004</factor>
			<offset>0.0</offset>
			<max>0.4</max>
		</transparency>
		<threshold>0.001</threshold>
	</animation>

