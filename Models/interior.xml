<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <path>interior2.ac</path>

  <animation>
    <object-name>interieur</object-name>
    <object-name>mancheD</object-name>
    <object-name>MancheG</object-name>
    <object-name>mancheG</object-name>
    <object-name>paloDD</object-name>
    <object-name>paloDG</object-name>
    <object-name>paloGD</object-name>
    <object-name>paloGG</object-name>
    <object-name>sieges</object-name> 
    
    <object-name>collective</object-name>
   
    <object-name>collective_base</object-name>
  </animation>

  <!-- Tableau de bord -->
  <model>
  <name>panel</name>
    <path>Aircraft/SA-315B-Lama/Models/Interior/Panel/panel.xml</path>
    <offsets>
      <x-m> -1.937 </x-m>
      <y-m>  0.000 </y-m>
      <z-m>  0.050 </z-m>
      <roll-deg>    0 </roll-deg>
      <pitch-deg>   0 </pitch-deg>
      <heading-deg> 0 </heading-deg>
    </offsets>
  </model>
  
   <!-- panel vibration experiment -->
 <animation>
    <type>translate</type>
    <object-name>panel</object-name>
   <condition>
				<greater-than>
					<property>sim/sound/vibration</property>
					<value>0.01</value>
				</greater-than>
			</condition>
    <factor>0.09</factor>
    <axis>
      <x> 1 </x>
      <y> 1 </y>
      <z> 1 </z>
    </axis>
  </animation>

  <animation>
    <type>translate</type>
    <object-name>panel</object-name>
    <property>rotors/main/vibration/longitudinal</property>
    <factor>0.009</factor>
    <axis>
      <x> -1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>
   <animation>
    <type>translate</type>
    <object-name>panel</object-name>
    <property>rotors/main/vibration/lateral</property>
    <factor>0.01</factor>
    <axis>
      <x> 0 </x>
      <y> -1 </y>
      <z> 0 </z>
    </axis>
  </animation>

  
   <model>
    <path>Aircraft/SA-315B-Lama/Models/Interior/Panel/overhead.xml</path>
    <offsets>
      <x-m> -1.97 </x-m>
      <y-m>  0.000 </y-m>
      <z-m>  0.050 </z-m>
      <roll-deg>    0 </roll-deg>
      <pitch-deg>   0 </pitch-deg>
      <heading-deg> 0 </heading-deg>
    </offsets>
  </model>
  
   <model>
    <path>Aircraft/SA-315B-Lama/Models/Interior/Panel/Instruments/MagCompass/magcompass.xml</path>
    <offsets>
      <x-m> -2.12 </x-m>
      <y-m>  0.000 </y-m>
      <z-m>  0.57 </z-m>
      <roll-deg>    0 </roll-deg>
      <pitch-deg>   0 </pitch-deg>
      <heading-deg> 0 </heading-deg>
    </offsets>
  </model>
