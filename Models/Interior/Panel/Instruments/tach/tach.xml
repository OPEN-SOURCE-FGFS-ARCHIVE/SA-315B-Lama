<?xml version="1.0"?>

<PropertyList>
	<path>Tach.ac</path>

  <animation>
    <type>noshadow</type>
    <object-name>glass</object-name>
  </animation>


  
     <effect>
        <inherits-from>Effects/model-transparent</inherits-from>
         <object-name>glass</object-name>
    </effect> 

  <animation>
    <type>material</type>
    <object-name>TurbineNeedle1</object-name>
    <object-name>RotorNeedle</object-name>
    <object-name>face</object-name>
    <emission>
      <factor-prop>controls/electric/directbat-switch</factor-prop>
      <red>   0.6 </red>
      <green> 0.3 </green>
      <blue>  0.3 </blue>
    </emission>
  </animation>


 <!-- Coompositor lights-->
  
  <light>
  <name>dash1</name>
  <type>spot</type>
  <position>
    <x-m>0.017</x-m>
    <y-m>0.0</y-m>
    <z-m>0</z-m>
  </position>
  <direction>
    <x>-1.0</x>
    <y>0</y>
    <z>0</z>
  </direction>
  <ambient>
    <r>0</r>
    <g>0</g>
    <b>1</b>
    <a>1</a>
  </ambient>
  <diffuse>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </diffuse>
  <specular>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </specular>
    <color>
      <r>0.6</r>
      <g>0.3</g>
      <b>0.3</b>
      <a>1.0</a>
    </color>
 <attenuation>
    <c>1</c>
    <l>1.5</l>
    <q>3.5</q>
  </attenuation>
  <spot-exponent>2</spot-exponent>
  <spot-cutoff>70</spot-cutoff>
  <range-m>0.05</range-m>
   <intensity>0.2</intensity>
  <dim-factor>
    <property>systems/electrical/outputs/instrument-lights</property>
  </dim-factor>
 
</light>


<animation>
  <type>select</type>
  <object-name>dash1</object-name>
		
  <condition>
  
   <equals>
    <property>controls/electric/directbat-switch</property>
    <value>true</value>
   </equals>
  
  </condition>
 </animation>

<!-- end compositor light -->





	<animation>
		<type>rotate</type>
		<object-name>TurbineNeedle1</object-name>
		<property>engines/engine[0]/n2-rpm</property>
		<interpolation>
			<entry><ind>0</ind><dep>0</dep></entry>
                  <entry><ind>10000</ind><dep>60</dep></entry>
			<entry><ind>20000</ind><dep>120</dep></entry>
			<entry><ind>30000</ind><dep>180</dep></entry>
			<entry><ind>40000</ind><dep>240</dep></entry>
                  <entry><ind>50000</ind><dep>300</dep></entry>
		</interpolation>
		<axis>
			<x>-1</x>
		</axis>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>RotorNeedle</object-name>
		<property>rotors/main/rpm</property>
		<interpolation>
			<entry><ind>0</ind><dep>0</dep></entry>
                  <entry><ind>150</ind><dep>90</dep></entry>
			<entry><ind>300</ind><dep>180</dep></entry>
			<entry><ind>450</ind><dep>270</dep></entry>
			<entry><ind>600</ind><dep>360</dep></entry>
		</interpolation>
		<axis>
			<x>-1</x>
		</axis>
	</animation>
</PropertyList>

