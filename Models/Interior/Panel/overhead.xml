<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <path>overhead.ac</path>
  
  <animation>
    <type>material</type>
    <object-name>overhead</object-name>
    
    <emission>
        <red>0.1</red>
        <green>0.1</green>
        <blue>0.1</blue>
      <factor-prop>controls/electric/directbat-switch</factor-prop>
    </emission>
  </animation>
  
   <!-- Beacon -->
   
    <model>
    <path>Aircraft/SA-315B-Lama/Models/Interior/Panel/Instruments/switches/beacon.xml</path>
    <offsets>
      <x-m> 0.48 </x-m>
      <y-m>  0.090 </y-m>
      <z-m> 0.679 </z-m>
      <roll-deg>    0.000 </roll-deg>
      <pitch-deg> 102.000 </pitch-deg>
      <heading-deg>180.000 </heading-deg>
    </offsets>
  </model>
   
<!-- landing light -->

<model>
    <path>Aircraft/SA-315B-Lama/Models/Interior/Panel/Instruments/switches/landing-lights.xml</path>
    <offsets>
      <x-m> 0.48 </x-m>
