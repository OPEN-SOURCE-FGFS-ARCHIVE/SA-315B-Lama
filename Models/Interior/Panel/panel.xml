 <animation>
    <type>rotate</type>
   <object-name>group_42</object-name>
   <object-name>fuel-cutoff</object-name>
    <property>controls/engines/engine/cutoff</property>
   <factor>63</factor>
    <center>
       <x-m> 0.1</x-m>
        <y-m> 0 </y-m>
        <z-m>-0.51</z-m>  
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>
  
  <animation>
<type>pick</type>
    <object-name>group_42</object-name>
   <object-name>fuel-cutoff</object-name>
	<action>
	<button>0</button>
      <repeatable>false</repeatable>
 		  <binding>
        <command>property-toggle</command>
       <property>controls/engines/engine/cutoff</property>
      </binding>	
		<binding>
